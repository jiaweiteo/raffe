# Configure in Vercel environment variables, never in frontend/VITE_* variables.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
RAFFLE_ADMIN_EMAILS=your-admin-email@example.com
# Optional comma-separated custom domains, without https://
RAFFLE_ALLOWED_HOSTS=
